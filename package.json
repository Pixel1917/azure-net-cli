{
	"name": "@azure-net/cli",
	"version": "6.0.0-next.3",
	"type": "module",
	"bin": {
		"azure-net": "bin/azure-net.js"
	},
	"license": "MIT",
	"author": "Pixel1917",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"peerDependencies": {
		"@azure-net/kit": ">=6.0.0-next.1"
	},
	"dependencies": {
		"commander": "^11",
		"prompts": "^2",
		"typescript": "^5",
		"prettier": "^3.6.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.31.0",
		"@types/node": "^24.0.3",
		"@types/prompts": "^2.4.9",
		"env-cmd": "^11.0.0",
		"eslint": "^9.31.0",
		"typescript-eslint": "^8.36.0"
	},
	"scripts": {
		"build": "node scripts/clean-build.mjs && tsc -p tsconfig.json && node scripts/sync-build.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "eslint \"bin/**/*.ts\" \"src/**/*.ts\"",
		"format": "prettier --write .",
		"test": "pnpm build && node --test tests/*.test.mjs",
		"prepack": "pnpm build"
	},
	"packageManager": "pnpm@9.13.2+sha512.88c9c3864450350e65a33587ab801acf946d7c814ed1134da4a924f6df5a2120fd36b46aab68f7cd1d413149112d53c7db3a4136624cfd00ff1846a0c6cef48a",
	"files": [
		"bin/*.js",
		"src/**/*.js",
		"dist/**/*.d.ts",
		"README.md"
	],
	"engines": {
		"node": ">=22.15.0"
	}
}
